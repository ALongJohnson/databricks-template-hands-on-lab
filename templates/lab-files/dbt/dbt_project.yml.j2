# {{ s.lab.company }} HOL · Step 1 · dbt project (run by a Lakeflow Job dbt task)
name: '{{ s.pipeline.dbt.project_name }}'
version: '1.0.0'
config-version: 2
profile: '{{ s.pipeline.dbt.project_name }}'   # the dbt task generates this profile from its SQL warehouse, catalog and schema

model-paths: ["models"]
test-paths: ["tests"]
clean-targets: ["target", "dbt_packages"]

models:
  {{ s.pipeline.dbt.project_name }}:
    bronze:
      +materialized: streaming_table   # Auto Loader: each run reads only newly landed files
    silver:
      +materialized: table
      +persist_docs: { relation: true, columns: true }
      +tblproperties: { quality: silver }
    gold:
      +materialized: table
      +persist_docs: { relation: true, columns: true }
      +tblproperties: { quality: gold }
