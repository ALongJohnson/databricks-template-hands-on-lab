# Copy to .env and fill in. Never commit .env.
#
# Step 1: today's setup. The agent calls a model provider directly.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-your-provider-key
MODEL_NAME=gpt-4.1-mini

# Step 2: route the same calls through Unity Gateway instead (no code change).
# MODEL_BASE_URL=https://<your-workspace-host>/ai-gateway/mlflow/v1
# MODEL_API_KEY=<a Databricks OAuth token or personal access token>
# MODEL_NAME=system.ai.claude-sonnet-4-5

# Step 3: send MLflow 3 traces to an experiment bound to Unity Catalog.
# DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_ID=<experiment-id>
# MLFLOW_TRACING_SQL_WAREHOUSE_ID=<sql-warehouse-id>
